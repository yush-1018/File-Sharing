# ── SECURITY WARNING: CHANGE ALL SECRETS BEFORE PRODUCTION DEPLOYMENT ──
NODE_ENV=production
PORT=8080
BASE_URL=https://your-domain.com

# ── JWT Secret (MUST be generated via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_32_BYTE_HEX_KEY

# ── Database & Cache Connections
MONGODB_URI=mongodb://localhost:27017/linkdrop
REDIS_URL=redis://localhost:6379

# ── Storage & MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=linkdrop
S3_ACCESS_KEY=GENERATE_CUSTOM_MINIO_USER
S3_SECRET_KEY=GENERATE_CUSTOM_MINIO_PASSWORD
S3_REGION=us-east-1
UPLOAD_DIR=./uploads

# ── STUN & TURN Relay Credentials (Coturn)
TURN_SERVER=turn:your-coturn-domain.com:3478
TURN_USER=GENERATE_SECURE_TURN_USER
TURN_PASSWORD=GENERATE_SECURE_TURN_PASSWORD
STUN_SERVER=stun:stun.l.google.com:19302

# ── Malware Scan (ClamAV)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
